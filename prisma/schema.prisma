// FX Bot Market — schema
// Extend this file; do not replace models wholesale.
// Run `npx prisma migrate dev --name <change>` after editing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // bcrypt hash, only set for credentials sign-in
  role          UserRole  @default(USER)
  bannedAt      DateTime? // set by an admin/moderator; blocks credentials sign-in
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  profile       Profile?
  sellerProfile SellerProfile?

  products           Product[]       @relation("ProductSeller")
  moderatingProducts Product[]       @relation("ProductModerator")
  reviews            Review[]
  ratings            ProductRating[]
  favorites          Favorite[]
  downloads          Download[]
  cart               Cart?
  orders             Order[]
  licenses           License[]
  subscriptions      Subscription[]
  notifications      Notification[]
  auditLogs          AuditLog[]      @relation("AuditActor")

  signalProviderProfile SignalProviderProfile?
  signalSubscriptions   SignalSubscription[]
  alerts                Alert[]
  calendarPreference    CalendarPreference?

  @@map("users")
}

// Public-facing profile, distinct from SellerProfile's business/payout data.
// Every user gets one; only sellers additionally get a SellerProfile.
model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String?
  bio           String?  @db.Text
  avatarUrl     String?
  location      String?
  websiteUrl    String?
  twitterHandle String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Role hierarchy (low -> high privilege), enforced centrally in
// src/lib/authorization — never hard-code role checks in page components.
// USER < SELLER == AUTHOR < MODERATOR < ADMIN < SUPER_ADMIN
enum UserRole {
  USER
  SELLER
  AUTHOR
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

// ---------- Seller / marketplace catalog ----------

model SellerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  bio         String?  @db.Text
  websiteUrl  String?
  payoutEmail String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model ProductCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  parentId String?

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@map("product_categories")
}

enum ProductType {
  EA
  INDICATOR
  SIGNAL
  TOOL
  OTHER
}

// UNDER_REVIEW is a distinct step from PENDING_REVIEW: PENDING_REVIEW means
// "submitted, waiting for a moderator to pick it up"; UNDER_REVIEW means a
// moderator has claimed it (see assignedModeratorId) and is actively
// reviewing. PUBLISHED is this app's "approved and live" state — Phase 2's
// spec calls it APPROVED, but renaming would touch every status check for
// no behavioral gain, so PUBLISHED stays and this comment documents the
// mapping instead.
enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum Platform {
  MT4
  MT5
  MULTI_PLATFORM
}

// Governs how priceCents is interpreted: FREE => priceCents must be 0,
// ONE_TIME => a single purchase, SUBSCRIPTION => price per billing period
// (see Subscription for the recurring state).
enum PricingType {
  FREE
  ONE_TIME
  SUBSCRIPTION
}

model Product {
  id                       String                   @id @default(cuid())
  slug                     String                   @unique
  sellerId                 String
  categoryId               String?
  name                     String
  type                     ProductType
  platform                 Platform                 @default(MT5)
  shortSummary             String
  description              String                   @db.Text
  features                 String[]                 @default([])
  requirements             String?                  @db.Text
  installationInstructions String?                  @db.Text
  compatibilityNotes       String?                  @db.Text
  supportInfo              String?                  @db.Text
  pricingType              PricingType              @default(ONE_TIME)
  priceCents               Int // 0 when pricingType = FREE
  currency                 String                   @default("USD")
  status                   ProductStatus            @default(DRAFT)
  rejectionReason          String?                  @db.Text // most recent rejection reason; full history is in AuditLog
  assignedModeratorId      String?
  featured                 Boolean                  @default(false)
  tags                     String[]                 @default([])
  viewCount                Int                      @default(0)
  searchVector             Unsupported("tsvector")?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  publishedAt              DateTime?

  seller            User             @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  category          ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedModerator User?            @relation("ProductModerator", fields: [assignedModeratorId], references: [id], onDelete: SetNull)

  versions      ProductVersion[]
  images        ProductImage[]
  screenshots   ProductScreenshot[]
  documentation ProductDocumentation[]
  reviews       Review[]
  ratings       ProductRating[]
  rating        ProductRatingSummary?
  favorites     Favorite[]
  downloads     Download[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  licenses      License[]
  subscriptions Subscription[]

  @@index([status, type])
  @@index([status, featured])
  @@index([status, pricingType])
  @@index([assignedModeratorId])
  @@map("products")
}

model ProductVersion {
  id        String   @id @default(cuid())
  productId String
  version   String
  changelog String?  @db.Text
  createdAt DateTime @default(now())

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  files   ProductFile[]

  @@unique([productId, version])
  @@map("product_versions")
}

// A version can ship more than one file (e.g. separate MT4 and MT5 builds).
model ProductFile {
  id               String   @id @default(cuid())
  productVersionId String
  platform         Platform
  fileName         String
  storageKey       String // key in object storage, resolved via StorageProvider
  fileSizeBytes    Int
  checksumSha256   String
  createdAt        DateTime @default(now())

  productVersion ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  downloads      Download[]

  @@map("product_files")
}

// Cover / gallery images shown on the product card and listing.
model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  storageKey String
  altText    String?
  position   Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// In-app screenshots (e.g. backtest results, chart setups) — distinct from
// the cover/gallery images used in listings.
model ProductScreenshot {
  id         String  @id @default(cuid())
  productId  String
  storageKey String
  caption    String?
  position   Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_screenshots")
}

model ProductDocumentation {
  id              String   @id @default(cuid())
  productId       String
  title           String
  contentMarkdown String?  @db.Text
  storageKey      String? // optional PDF/attachment alternative to inline markdown
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_documentation")
}

model Review {
  id                String    @id @default(cuid())
  productId         String
  userId            String
  rating            Int // 1-5
  title             String?
  body              String?   @db.Text
  verifiedPurchase  Boolean   @default(false) // set at creation from a PAID OrderItem check; not re-derived later
  sellerResponse    String?   @db.Text
  sellerRespondedAt DateTime?
  hidden            Boolean   @default(false) // admin moderation: hide instead of hard-delete by default
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("reviews")
}

// Lightweight star-only rating, for users who rate without writing a full
// review. Kept separate from Review (which also carries a body) so a user
// can do either without the two flows colliding on the same unique key.
model ProductRating {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("product_ratings")
}

// Materialized aggregate (average + star breakdown) over Review + ProductRating,
// recomputed by the review/rating service on write. Read this for display
// instead of aggregating on every request.
model ProductRatingSummary {
  productId String   @id
  average   Float    @default(0)
  count     Int      @default(0)
  star1     Int      @default(0)
  star2     Int      @default(0)
  star3     Int      @default(0)
  star4     Int      @default(0)
  star5     Int      @default(0)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_rating_summaries")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model Download {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  productFileId String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productFile ProductFile? @relation(fields: [productFileId], references: [id], onDelete: SetNull)

  @@index([userId, productId])
  @@index([productId])
  @@map("downloads")
}

// ---------- Cart / orders / payments / licensing / subscriptions ----------

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  status     OrderStatus @default(PENDING)
  totalCents Int
  currency   String      @default("USD")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payments Payment[]
  licenses License[]

  @@map("orders")
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  unitPriceCents Int
  quantity       Int    @default(1)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

enum PaymentProviderName {
  STRIPE
  MPESA
  MANUAL
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                String              @id @default(cuid())
  orderId           String
  provider          PaymentProviderName
  status            PaymentStatus       @default(INITIATED)
  amountCents       Int
  currency          String              @default("USD")
  providerReference String? // e.g. Stripe payment_intent id, M-Pesa checkout request id
  rawPayload        Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider, providerReference])
  @@map("payments")
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// Doubles as the entitlement record: a Download is authorized when a
// non-revoked, non-expired License exists for (userId, productId) — see
// src/features/downloads/entitlement-service.ts. `key` is a stable
// identifier a future MT4/MT5-side verification endpoint can check; no such
// endpoint exists yet, so this does not actually protect a running EA today
// (see src/app/api/licenses/verify/route.ts's doc comment).
model License {
  id             String        @id @default(cuid())
  userId         String
  productId      String
  orderId        String?
  status         LicenseStatus @default(ACTIVE)
  key            String        @unique @default(cuid())
  activations    Int           @default(0)
  maxActivations Int           @default(1)
  issuedAt       DateTime      @default(now())
  expiresAt      DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@map("licenses")
}

// Shared by product Subscription and SignalSubscription. Phase 3's spec
// spells the third state "CANCELLED" for signal subscriptions specifically
// — reusing this enum (already "CANCELED", American spelling, established
// in Phase 2) instead of adding a near-duplicate enum for one spelling
// difference. PAUSED added here for signal subscriptions (a subscriber
// pausing without cancelling); product Subscription just never sets it.
enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
  PAUSED
}

model Subscription {
  id                String               @id @default(cuid())
  userId            String
  productId         String
  status            SubscriptionStatus   @default(ACTIVE)
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean              @default(false)
  provider          PaymentProviderName?
  providerReference String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("subscriptions")
}

// ---------- Notifications / audit ----------

enum NotificationType {
  GENERAL
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  PRODUCT_SUSPENDED
  ORDER_PAID
  REVIEW_RECEIVED
  SYSTEM
  PRICE_CHANGE
  NEW_VERSION
  PRODUCT_UPDATE
  SIGNAL_PUBLISHED
  SIGNAL_CLOSED
  ECONOMIC_EVENT_ALERT
  NEWS_ALERT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// Append-only moderation/action trail. actorId is nullable for
// system-initiated entries (e.g. a scheduled job).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "product.approve", "user.role_change"
  entityType String // e.g. "Product", "User"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------- Economic calendar ----------

enum EventImpact {
  HOLIDAY
  LOW
  MEDIUM
  HIGH
  OTHER
}

enum EventCategory {
  CENTRAL_BANK
  EMPLOYMENT
  INFLATION
  GDP
  MANUFACTURING
  RETAIL
  HOUSING
  CONSUMER
  POLITICS
  OTHER
}

model EconomicEvent {
  id          String        @id @default(cuid())
  externalId  String?       @unique // id from upstream data provider, for de-duplication on sync
  country     String
  currency    String
  title       String
  impact      EventImpact
  category    EventCategory @default(OTHER)
  eventTime   DateTime
  actual      String?
  forecast    String?
  previous    String?
  // Free-text context shown on the event detail page — not a data feed
  // field, filled in by whoever creates/edits the event (ManualProvider
  // today; an admin editing the row later).
  description String?       @db.Text
  source      String // e.g. "manual", "provider:xyz" — matches DataSource.providerKey
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([eventTime])
  @@index([currency, eventTime])
  @@index([impact, eventTime])
  @@index([category, eventTime])
  @@map("economic_events")
}

// Per-user saved calendar filter preferences (currencies/countries/impacts/
// categories to default to) — a DB row rather than localStorage so it
// follows the user across devices, consistent with the rest of the app's
// state.
model CalendarPreference {
  id         String          @id @default(cuid())
  userId     String          @unique
  currencies String[]        @default([])
  countries  String[]        @default([])
  impacts    EventImpact[]   @default([])
  categories EventCategory[] @default([])
  updatedAt  DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_preferences")
}

// ---------- Forex news ----------

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model NewsCategory {
  id       String        @id @default(cuid())
  name     String        @unique
  slug     String        @unique
  articles NewsArticle[]

  @@map("news_categories")
}

// Summaries + attribution only — never full copied article bodies (see
// CLAUDE.md's data-sourcing rule). `sourceUrl` is where a reader goes for
// the complete piece.
model NewsArticle {
  id          String        @id @default(cuid())
  slug        String        @unique
  externalId  String?       @unique // for de-duplication on sync, like EconomicEvent
  title       String
  summary     String        @db.Text
  sourceName  String
  sourceUrl   String
  imageUrl    String? // only ever a licensed/permitted image — see ingestion notes
  currency    String? // optional related currency, for filtering (e.g. "USD")
  categoryId  String?
  tags        String[]      @default([])
  breaking    Boolean       @default(false)
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([currency, status, publishedAt])
  @@map("news_articles")
}

// ---------- Forex signals ----------

enum SignalDirection {
  BUY
  SELL
  WATCH
}

enum SignalStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum SignalTimeframe {
  M1
  M5
  M15
  M30
  H1
  H4
  D1
  W1
}

enum SignalPricingType {
  FREE
  SUBSCRIPTION
}

// Distinct from SellerProfile: a user can sell marketplace products,
// publish signals, both, or neither — these are separate capabilities with
// separate verification. `verified` is admin-controlled and gates the
// "Verified performance" badge; everything else on a provider's stats is
// self-reported until an admin flips it (see CLAUDE.md — never compute a
// misleading verified badge from unverified data).
model SignalProviderProfile {
  id           String            @id @default(cuid())
  userId       String            @unique
  slug         String            @unique
  displayName  String
  avatarUrl    String?
  bio          String?           @db.Text
  tradingStyle String?
  markets      String[]          @default([])
  pricingType  SignalPricingType @default(FREE)
  priceCents   Int               @default(0)
  currency     String            @default("USD")
  verified     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  signals       Signal[]
  subscriptions SignalSubscription[]

  @@map("signal_provider_profiles")
}

model Signal {
  id             String          @id @default(cuid())
  providerId     String
  instrument     String // e.g. "EURUSD"
  direction      SignalDirection
  status         SignalStatus    @default(ACTIVE)
  entryZoneLow   Float?
  entryZoneHigh  Float?
  stopLoss       Float?
  takeProfit     Float[]         @default([])
  timeframe      SignalTimeframe
  reasonMarkdown String?         @db.Text
  resultPips     Float? // filled when status -> CLOSED; null while ACTIVE
  publishedAt    DateTime        @default(now())
  closedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  provider SignalProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, publishedAt])
  @@index([status, publishedAt])
  @@index([instrument, publishedAt])
  @@map("signals")
}

model SignalSubscription {
  id                String             @id @default(cuid())
  userId            String
  providerId        String
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider SignalProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@map("signal_subscriptions")
}

// ---------- User alerts ----------

enum AlertType {
  ECONOMIC_EVENT
  CURRENCY
  SIGNAL_PROVIDER
  PRODUCT
  NEWS_TOPIC
}

enum AlertChannel {
  IN_APP
  EMAIL
  PUSH // not implemented yet — see src/features/alerts/dispatch-service.ts
}

// Polymorphic by convention, uniformly via `targetId` (required — every
// alert type has a concrete target: a currency code for CURRENCY, an
// EconomicEvent id for ECONOMIC_EVENT, a SignalProviderProfile id for
// SIGNAL_PROVIDER, a Product id for PRODUCT, a NewsCategory id for
// NEWS_TOPIC). Deliberately no FK to any of those tables: a target row
// being deleted shouldn't cascade-delete the subscription — "notify me
// about EURUSD" shouldn't vanish just because one EconomicEvent row
// mentioning EURUSD was removed. Also: a nullable field can't cleanly
// participate in a compound unique constraint for findUnique/upsert
// lookups (Postgres NULLs aren't equal to each other), which is the other
// reason this is required rather than optional.
model Alert {
  id        String         @id @default(cuid())
  userId    String
  type      AlertType
  targetId  String
  channels  AlertChannel[] @default([IN_APP])
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, targetId])
  @@index([type, targetId])
  @@map("alerts")
}

// ---------- Data sync architecture ----------

enum DataSourceKind {
  CALENDAR
  NEWS
  MARKET_DATA
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

// Admin-manageable registry of where calendar/news/market data comes from.
// `providerKey` matches a provider adapter's key (see
// src/services/calendar/providers, src/services/news/providers) so an admin
// can enable/disable or reconfigure a source without a deploy.
model DataSource {
  id             String         @id @default(cuid())
  name           String
  kind           DataSourceKind
  providerKey    String
  enabled        Boolean        @default(true)
  config         Json?
  lastSyncAt     DateTime?
  lastSyncStatus SyncStatus?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([kind, providerKey])
  @@map("data_sources")
}

// One row per background job run — gives admins visibility into sync
// failures instead of only finding out when the calendar looks stale.
model SyncLog {
  id             String     @id @default(cuid())
  jobName        String // "calendarSync" | "newsSync" | "marketDataSync"
  status         SyncStatus
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  itemsProcessed Int?
  itemsFailed    Int        @default(0)
  error          String?    @db.Text

  @@index([jobName, startedAt])
  @@map("sync_logs")
}

// ---------- Marketplace configuration ----------

// Singleton row (id is always "singleton") holding admin-configurable
// marketplace-wide settings. Read via src/features/admin/settings-service.ts,
// which upserts the row on first read so callers never have to null-check.
model MarketplaceSettings {
  id                String   @id @default("singleton")
  commissionPercent Float    @default(20)
  // Weights for the discovery ranking score (see
  // src/lib/ranking/ranking-service.ts) — sales, downloads, reviews,
  // rating, recency, favorites. Admin-editable at /admin/settings.
  rankingWeights    Json     @default("{\"sales\":3,\"downloads\":1,\"reviews\":1,\"rating\":2,\"recency\":1,\"favorites\":1}")
  updatedAt         DateTime @updatedAt

  @@map("marketplace_settings")
}
