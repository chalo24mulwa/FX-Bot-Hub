// FX Bot Market — schema
// Extend this file; do not replace models wholesale.
// Run `npx prisma migrate dev --name <change>` after editing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // bcrypt hash, only set for credentials sign-in
  role          UserRole  @default(USER)
  bannedAt      DateTime? // set by an admin/moderator; blocks credentials sign-in
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  profile       Profile?
  sellerProfile SellerProfile?

  products           Product[]       @relation("ProductSeller")
  moderatingProducts Product[]       @relation("ProductModerator")
  reviews            Review[]
  ratings            ProductRating[]
  favorites          Favorite[]
  downloads          Download[]
  cart               Cart?
  orders             Order[]
  licenses           License[]
  subscriptions      Subscription[]
  notifications      Notification[]
  auditLogs          AuditLog[]      @relation("AuditActor")

  invoicesAsBuyer  Invoice[]       @relation("InvoiceBuyer")
  invoicesAsSeller Invoice[]       @relation("InvoiceSeller")
  ledgerEntries    LedgerEntry[]
  payouts          Payout[]
  securityEvents   SecurityEvent[]

  signalProviderProfile SignalProviderProfile?
  signalSubscriptions   SignalSubscription[]
  alerts                Alert[]
  calendarPreference    CalendarPreference?

  analyticsEvents AnalyticsEvent[]

  // Phase 5: admin user list filters by role and sorts by createdAt.
  @@index([role, createdAt])
  @@map("users")
}

// Public-facing profile, distinct from SellerProfile's business/payout data.
// Every user gets one; only sellers additionally get a SellerProfile.
model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String?
  bio           String?  @db.Text
  avatarUrl     String?
  location      String?
  websiteUrl    String?
  twitterHandle String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// "Forgot password" flow — deliberately a separate model from
// VerificationToken above (Auth.js's own adapter table, meant for a
// magic-link/passwordless Email provider we don't use) rather than
// overloading it, and deliberately stores only a SHA-256 hash of the
// token, never the raw value — a DB read alone can never be replayed to
// reset a password, only the exact emailed link can. Single-use: consumed
// by setting `usedAt` in the same transaction that updates the password
// (see resetPassword() in src/features/auth/password-reset-service.ts),
// which also invalidates any other outstanding tokens for that user.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Role hierarchy (low -> high privilege), enforced centrally in
// src/lib/authorization — never hard-code role checks in page components.
// USER < SELLER == AUTHOR < MODERATOR < ADMIN < SUPER_ADMIN
enum UserRole {
  USER
  SELLER
  AUTHOR
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

// ---------- Seller / marketplace catalog ----------

model SellerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  bio         String?  @db.Text
  websiteUrl  String?
  payoutEmail String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model ProductCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  parentId String?

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@map("product_categories")
}

enum ProductType {
  EA
  INDICATOR
  SIGNAL
  TOOL
  OTHER
}

// UNDER_REVIEW is a distinct step from PENDING_REVIEW: PENDING_REVIEW means
// "submitted, waiting for a moderator to pick it up"; UNDER_REVIEW means a
// moderator has claimed it (see assignedModeratorId) and is actively
// reviewing. PUBLISHED is this app's "approved and live" state — Phase 2's
// spec calls it APPROVED, but renaming would touch every status check for
// no behavioral gain, so PUBLISHED stays and this comment documents the
// mapping instead.
enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  UNDER_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum Platform {
  MT4
  MT5
  MULTI_PLATFORM
}

// Governs how priceCents is interpreted: FREE => priceCents must be 0,
// ONE_TIME => a single purchase, SUBSCRIPTION => price per billing period
// (see Subscription for the recurring state).
enum PricingType {
  FREE
  ONE_TIME
  SUBSCRIPTION
}

model Product {
  id                       String                   @id @default(cuid())
  slug                     String                   @unique
  sellerId                 String
  categoryId               String?
  name                     String
  type                     ProductType
  platform                 Platform                 @default(MT5)
  shortSummary             String
  description              String                   @db.Text
  features                 String[]                 @default([])
  requirements             String?                  @db.Text
  installationInstructions String?                  @db.Text
  compatibilityNotes       String?                  @db.Text
  supportInfo              String?                  @db.Text
  pricingType              PricingType              @default(ONE_TIME)
  priceCents               Int // 0 when pricingType = FREE
  currency                 String                   @default("USD")
  status                   ProductStatus            @default(DRAFT)
  rejectionReason          String?                  @db.Text // most recent rejection reason; full history is in AuditLog
  assignedModeratorId      String?
  featured                 Boolean                  @default(false)
  tags                     String[]                 @default([])
  viewCount                Int                      @default(0)
  searchVector             Unsupported("tsvector")?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  publishedAt              DateTime?

  seller            User             @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  category          ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  assignedModerator User?            @relation("ProductModerator", fields: [assignedModeratorId], references: [id], onDelete: SetNull)

  versions        ProductVersion[]
  images          ProductImage[]
  screenshots     ProductScreenshot[]
  documentation   ProductDocumentation[]
  reviews         Review[]
  ratings         ProductRating[]
  rating          ProductRatingSummary?
  favorites       Favorite[]
  downloads       Download[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  licenses        License[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  analyticsEvents AnalyticsEvent[]

  @@index([status, type])
  @@index([status, featured])
  @@index([status, pricingType])
  @@index([assignedModeratorId])
  // Phase 5: marketplace default sort and the moderation queue both sort by
  // one of these within a status filter — neither was covered before.
  @@index([status, publishedAt])
  @@index([status, updatedAt])
  @@map("products")
}

model ProductVersion {
  id        String   @id @default(cuid())
  productId String
  version   String
  changelog String?  @db.Text
  createdAt DateTime @default(now())

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  files   ProductFile[]

  @@unique([productId, version])
  @@map("product_versions")
}

// A version can ship more than one file (e.g. separate MT4 and MT5 builds).
model ProductFile {
  id               String   @id @default(cuid())
  productVersionId String
  platform         Platform
  fileName         String
  storageKey       String // key in object storage, resolved via StorageProvider
  fileSizeBytes    Int
  checksumSha256   String
  createdAt        DateTime @default(now())

  productVersion ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  downloads      Download[]

  @@map("product_files")
}

// Cover / gallery images shown on the product card and listing.
model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  storageKey String
  altText    String?
  position   Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// In-app screenshots (e.g. backtest results, chart setups) — distinct from
// the cover/gallery images used in listings.
model ProductScreenshot {
  id         String  @id @default(cuid())
  productId  String
  storageKey String
  caption    String?
  position   Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_screenshots")
}

model ProductDocumentation {
  id              String   @id @default(cuid())
  productId       String
  title           String
  contentMarkdown String?  @db.Text
  storageKey      String? // optional PDF/attachment alternative to inline markdown
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_documentation")
}

model Review {
  id                String    @id @default(cuid())
  productId         String
  userId            String
  rating            Int // 1-5
  title             String?
  body              String?   @db.Text
  verifiedPurchase  Boolean   @default(false) // set at creation from a PAID OrderItem check; not re-derived later
  sellerResponse    String?   @db.Text
  sellerRespondedAt DateTime?
  hidden            Boolean   @default(false) // admin moderation: hide instead of hard-delete by default
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("reviews")
}

// Lightweight star-only rating, for users who rate without writing a full
// review. Kept separate from Review (which also carries a body) so a user
// can do either without the two flows colliding on the same unique key.
model ProductRating {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("product_ratings")
}

// Materialized aggregate (average + star breakdown) over Review + ProductRating,
// recomputed by the review/rating service on write. Read this for display
// instead of aggregating on every request.
model ProductRatingSummary {
  productId String   @id
  average   Float    @default(0)
  count     Int      @default(0)
  star1     Int      @default(0)
  star2     Int      @default(0)
  star3     Int      @default(0)
  star4     Int      @default(0)
  star5     Int      @default(0)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_rating_summaries")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model Download {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  productFileId String?
  // false = an authenticated user hit the download route without a valid
  // entitlement (denied at src/app/api/downloads/[productFileId]/route.ts)
  // — recorded so denied attempts are visible, not just successful ones.
  success       Boolean  @default(true)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productFile ProductFile? @relation(fields: [productFileId], references: [id], onDelete: SetNull)

  @@index([userId, productId])
  @@index([productId])
  @@map("downloads")
}

// ---------- Cart / orders / payments / licensing / subscriptions ----------

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  status         OrderStatus @default(PENDING)
  // Client-supplied key (see src/features/checkout/checkout-service.ts) so a
  // retried checkout submission — a double-click, a flaky network retry —
  // returns the existing order instead of creating a second one. Optional:
  // system-initiated orders (e.g. subscription renewals) don't need one.
  idempotencyKey String?     @unique
  totalCents     Int
  currency       String      @default("USD")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payments Payment[]
  licenses License[]
  refunds  Refund[]
  invoices Invoice[]

  // Phase 5: "my orders" sorts by createdAt within a user; admin/finance
  // reads filter by status and sort by createdAt.
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  unitPriceCents Int
  quantity       Int    @default(1)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  invoice Invoice?

  @@map("order_items")
}

enum PaymentProviderName {
  STRIPE
  MPESA
  MANUAL
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                String              @id @default(cuid())
  orderId           String
  provider          PaymentProviderName
  status            PaymentStatus       @default(INITIATED)
  amountCents       Int
  currency          String              @default("USD")
  // e.g. Stripe payment_intent id, M-Pesa checkout request id, or this
  // app's own manual_<uuid>. Unique per provider so a payment can never be
  // recorded twice for the same upstream charge — see PaymentService.
  providerReference String?
  rawPayload        Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([provider, providerReference])
  @@map("payments")
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED // admin/fraud hold — reversible, unlike REVOKED
  REVOKED
  EXPIRED
}

// Doubles as the entitlement record for ONE_TIME/FREE products: a download
// is authorized when a non-suspended/revoked/expired License exists for
// (userId, productId) — see src/features/downloads/entitlement-service.ts.
// SUBSCRIPTION-priced products are entitled via Subscription instead (see
// below); no License row is created for those. `key` is the credential an
// MT4/MT5 EA presents to /api/licenses/verify — see that route's doc
// comment for what it does and doesn't protect against.
model License {
  id             String        @id @default(cuid())
  userId         String
  productId      String
  orderId        String?
  status         LicenseStatus @default(ACTIVE)
  key            String        @unique @default(cuid())
  activations    Int           @default(0)
  maxActivations Int           @default(1)
  issuedAt       DateTime      @default(now())
  expiresAt      DateTime?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  licenseActivations LicenseActivation[]

  @@unique([userId, productId])
  // Phase 5: both the buyer-facing and admin license lists sort by issuedAt.
  @@index([issuedAt])
  @@map("licenses")
}

// One row per machine/terminal that has activated a License, so
// maxActivations is enforced against real slots (not just a counter that
// can drift) and a specific activation can be deactivated to free a slot.
model LicenseActivation {
  id            String    @id @default(cuid())
  licenseId     String
  machineId     String // client-supplied fingerprint (e.g. MT4/MT5 account/terminal id)
  activatedAt   DateTime  @default(now())
  deactivatedAt DateTime?
  ipAddress     String?

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, machineId])
  @@index([licenseId])
  @@map("license_activations")
}

// Shared by product Subscription and SignalSubscription. Phase 3's spec
// spells the third state "CANCELLED" for signal subscriptions specifically
// — reusing this enum (already "CANCELED", American spelling, established
// in Phase 2) instead of adding a near-duplicate enum for one spelling
// difference. PAUSED added here for signal subscriptions (a subscriber
// pausing without cancelling); product Subscription just never sets it.
// TRIAL (Phase 4) is only used by product Subscription.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
  PAUSED
}

model Subscription {
  id                String               @id @default(cuid())
  userId            String
  productId         String
  status            SubscriptionStatus   @default(ACTIVE)
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean              @default(false)
  provider          PaymentProviderName?
  providerReference String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  // Phase 5: the renewal worker's every-tick query filters exactly this way.
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

// ---------- Commerce: refunds, invoices, ledger, payouts, fraud/security ----------

// Dedup table for inbound webhook deliveries, keyed by the provider's own
// event id (distinct from Payment.providerReference, which identifies the
// charge — a single charge can generate multiple webhook deliveries, e.g.
// Stripe retries). PaymentService.handleWebhook checks this before touching
// any Order/Payment state, so a duplicate delivery is a no-op, not a
// double-processed payment.
model ProcessedWebhookEvent {
  id         String              @id @default(cuid())
  provider   PaymentProviderName
  eventId    String
  receivedAt DateTime            @default(now())

  @@unique([provider, eventId])
  @@map("processed_webhook_events")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

// requestedByUserId/processedByUserId are plain ids (not relations), same
// pattern as AuditLog's actorId — this is an audit-trail field, not
// something the app queries "this user's refunds they processed" by.
model Refund {
  id                      String       @id @default(cuid())
  paymentId               String
  orderId                 String
  amountCents             Int
  currency                String
  reason                  String?      @db.Text
  status                  RefundStatus @default(REQUESTED)
  requestedByUserId       String
  processedByUserId       String?
  providerRefundReference String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

enum InvoiceStatus {
  OPEN
  PAID
  REFUNDED
  VOID
}

// One invoice per OrderItem (not per Order) — a cart can mix products from
// different sellers, and an invoice's "Seller"/"Product" fields are
// singular, so this is the natural granularity. Generated when the order
// is marked PAID (see completePaidOrder), never edited after — a refund
// changes `status`, not the recorded amount.
model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  orderId          String
  orderItemId      String        @unique
  buyerId          String
  sellerId         String
  productId        String
  amountCents      Int
  currency         String
  status           InvoiceStatus @default(OPEN)
  paymentReference String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  buyer     User      @relation("InvoiceBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller    User      @relation("InvoiceSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Phase 5: both list views filter by one of these and sort by createdAt.
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@map("invoices")
}

enum LedgerEntryType {
  SALE
  COMMISSION
  REFUND
  ADJUSTMENT
  PAYOUT
}

// Append-only financial ledger — a seller's balance is the SUM of their
// entries (src/repositories/ledger-repository.ts's getSellerBalance),
// never a stored/overwritten counter, so it can't drift out of sync with
// its own history. amountCents is signed: SALE credits the seller
// (+gross), COMMISSION debits the marketplace's cut (-commission), REFUND
// debits back out the seller's net share of a refunded sale, PAYOUT debits
// what's been paid out, ADJUSTMENT is a signed admin correction.
model LedgerEntry {
  id          String          @id @default(cuid())
  sellerId    String
  type        LedgerEntryType
  amountCents Int
  currency    String
  orderId     String?
  orderItemId String?
  refundId    String?
  payoutId    String?
  description String
  createdAt   DateTime        @default(now())

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
  @@index([type, createdAt])
  @@map("ledger_entries")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

// Payout processing (Stripe Connect / M-Pesa B2C) isn't wired up — same gap
// as SellerProfile.payoutEmail (see CLAUDE.md). This model tracks the
// payout *request and record*; an admin marks it PAID once money has moved
// through whatever manual/external channel is actually in use today.
model Payout {
  id                String       @id @default(cuid())
  sellerId          String
  amountCents       Int
  currency          String
  status            PayoutStatus @default(PENDING)
  payoutEmail       String?
  requestedAt       DateTime     @default(now())
  processedAt       DateTime?
  processedByUserId String?
  notes             String?      @db.Text

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, status])
  @@map("payouts")
}

enum SecurityEventType {
  REPEATED_PAYMENT_FAILURE
  SUSPICIOUS_DOWNLOAD_PATTERN
  WEBHOOK_SIGNATURE_INVALID
  DUPLICATE_WEBHOOK
  MULTIPLE_FAILED_LICENSE_ACTIVATIONS
  OTHER
}

enum SecurityEventSeverity {
  LOW
  MEDIUM
  HIGH
}

// Signal, don't act: recorded for admin visibility, never triggers an
// automatic ban/suspension by itself — see CLAUDE.md's fraud/security note.
model SecurityEvent {
  id        String                @id @default(cuid())
  userId    String?
  type      SecurityEventType
  severity  SecurityEventSeverity @default(LOW)
  metadata  Json?
  ipAddress String?
  createdAt DateTime              @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId])
  // Phase 5: the admin security-events list is unfiltered, sorted by createdAt.
  @@index([createdAt])
  @@map("security_events")
}

// ---------- Notifications / audit ----------

enum NotificationType {
  GENERAL
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  PRODUCT_SUSPENDED
  ORDER_PAID
  REVIEW_RECEIVED
  SYSTEM
  PRICE_CHANGE
  NEW_VERSION
  PRODUCT_UPDATE
  SIGNAL_PUBLISHED
  SIGNAL_CLOSED
  ECONOMIC_EVENT_ALERT
  NEWS_ALERT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  // Phase 5: the notification list sorts by createdAt within a user.
  @@index([userId, createdAt])
  @@map("notifications")
}

// Append-only moderation/action trail. actorId is nullable for
// system-initiated entries (e.g. a scheduled job).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "product.approve", "user.role_change"
  entityType String // e.g. "Product", "User"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  // Phase 5: the admin audit log list is unfiltered, sorted by createdAt.
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------- Phase 5: platform analytics ----------

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  SEARCH
  FAVORITE
  DOWNLOAD
  PURCHASE
  SIGNAL_VIEW
  CALENDAR_VIEW
}

// Deliberately minimal: no IP address, no user agent, no full URL/query
// string stored — just enough to answer "how much of X happened, on what,
// by whom (optionally)" for the admin/seller analytics views. `userId` is
// nullable so anonymous browsing can still be counted without requiring a
// session; an authenticated event can be cleared by setting userId to null
// (see src/lib/analytics/track.ts's anonymize note) without losing the
// aggregate counts it contributes to.
model AnalyticsEvent {
  id        String             @id @default(cuid())
  type      AnalyticsEventType
  userId    String?
  productId String?
  metadata  Json? // small, non-identifying context only (e.g. {"query": "trend ea"} for SEARCH)
  createdAt DateTime           @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([productId, type, createdAt])
  @@index([userId, createdAt])
  @@map("analytics_events")
}

// ---------- Economic calendar ----------

enum EventImpact {
  HOLIDAY
  LOW
  MEDIUM
  HIGH
  OTHER
}

enum EventCategory {
  CENTRAL_BANK
  EMPLOYMENT
  INFLATION
  GDP
  MANUFACTURING
  RETAIL
  HOUSING
  CONSUMER
  POLITICS
  OTHER
}

// Calendar-enhancement phase: a provider-fed event's lifecycle.
// SCHEDULED -> RELEASED once `actual` is populated by a sync; a provider
// can instead move it to CANCELLED/POSTPONED (see sync-service's
// `detectStatusTransition`) rather than the row ever being deleted — see
// the "provider failure" note on EconomicEvent below. Manual events start
// and stay SCHEDULED/RELEASED at the admin's discretion; nothing
// auto-cancels a manually-entered row.
enum EconomicEventStatus {
  SCHEDULED
  RELEASED
  CANCELLED
  POSTPONED
}

model EconomicEvent {
  id          String        @id @default(cuid())
  externalId  String?       @unique // id from upstream data provider, for de-duplication on sync
  country     String
  currency    String
  title       String
  impact      EventImpact
  category    EventCategory @default(OTHER)
  eventTime   DateTime
  actual      String?
  forecast    String?
  previous    String?
  // The value `previous` held immediately before a provider revision
  // overwrote it (e.g. last month's CPI print gets revised from 2.9% to
  // 3.0% alongside this month's release) — set by the sync job, never by
  // ManualProvider. Kept alongside `previous` (which always holds the
  // latest value) so the UI can show "Revised from X" instead of silently
  // swapping the number. See EconomicEventRevision for the full change log.
  revisedPrevious String?
  unit            String? // e.g. "%", "K", "B USD" — provider-reported, display-only
  frequency       String? // e.g. "Monthly", "Quarterly" — provider-reported, display-only
  status          EconomicEventStatus @default(SCHEDULED)
  // Deep link to the provider's own page for this release, for attribution
  // — required by most licensed-feed terms of use. Null for manual events.
  sourceUrl       String?
  // Last time a sync job touched this row (insert or update) — distinct
  // from `updatedAt`, which also changes on an admin's manual edit. Used
  // by the admin calendar dashboard to show per-event staleness and by
  // ops to confirm a sync actually reached a given row.
  lastSyncedAt    DateTime?
  // Free-text context shown on the event detail page — not a data feed
  // field, filled in by whoever creates/edits the event (ManualProvider
  // today; an admin editing the row later).
  description String?       @db.Text
  source      String // e.g. "manual", "authorized" — matches DataSource.providerKey
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  revisions EconomicEventRevision[]

  @@index([eventTime])
  @@index([currency, eventTime])
  @@index([impact, eventTime])
  @@index([category, eventTime])
  @@index([status, eventTime])
  @@index([lastSyncedAt])
  @@map("economic_events")
}

// Append-only audit trail of what a sync (or an admin edit) changed on an
// EconomicEvent — one row per changed field per sync pass, not one row per
// sync. Powers the "Updated"/"Revised" badge on the calendar UI without
// requiring the frontend to diff two snapshots itself.
model EconomicEventRevision {
  id           String   @id @default(cuid())
  eventId      String
  fieldChanged String // "forecast" | "previous" | "actual" | "eventTime" | "impact" | "status" | ...
  oldValue     String?
  newValue     String?
  changedAt    DateTime @default(now())
  provider     String // matches EconomicEvent.source at the time of the change

  event EconomicEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, changedAt])
  @@map("economic_event_revisions")
}

// Per-user saved calendar filter preferences (currencies/countries/impacts/
// categories to default to) — a DB row rather than localStorage so it
// follows the user across devices, consistent with the rest of the app's
// state.
model CalendarPreference {
  id         String          @id @default(cuid())
  userId     String          @unique
  currencies String[]        @default([])
  countries  String[]        @default([])
  impacts    EventImpact[]   @default([])
  categories EventCategory[] @default([])
  // IANA zone id (e.g. "Africa/Nairobi"). Null means "use the site
  // default" (Africa/Nairobi — see src/lib/calendar/timezone.ts) rather
  // than duplicating that default here, so changing the site default
  // doesn't require a data migration across every saved preference row.
  timezone   String?
  updatedAt  DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_preferences")
}

// ---------- Forex news ----------

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model NewsCategory {
  id       String        @id @default(cuid())
  name     String        @unique
  slug     String        @unique
  articles NewsArticle[]

  @@map("news_categories")
}

// Summaries + attribution only — never full copied article bodies (see
// CLAUDE.md's data-sourcing rule). `sourceUrl` is where a reader goes for
// the complete piece.
model NewsArticle {
  id          String        @id @default(cuid())
  slug        String        @unique
  externalId  String?       @unique // for de-duplication on sync, like EconomicEvent
  title       String
  summary     String        @db.Text
  sourceName  String
  sourceUrl   String
  imageUrl    String? // only ever a licensed/permitted image — see ingestion notes
  currency    String? // optional related currency, for filtering (e.g. "USD")
  categoryId  String?
  tags        String[]      @default([])
  breaking    Boolean       @default(false)
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([currency, status, publishedAt])
  @@map("news_articles")
}

// ---------- Forex signals ----------

enum SignalDirection {
  BUY
  SELL
  WATCH
}

enum SignalStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum SignalTimeframe {
  M1
  M5
  M15
  M30
  H1
  H4
  D1
  W1
}

enum SignalPricingType {
  FREE
  SUBSCRIPTION
}

// Distinct from SellerProfile: a user can sell marketplace products,
// publish signals, both, or neither — these are separate capabilities with
// separate verification. `verified` is admin-controlled and gates the
// "Verified performance" badge; everything else on a provider's stats is
// self-reported until an admin flips it (see CLAUDE.md — never compute a
// misleading verified badge from unverified data).
model SignalProviderProfile {
  id           String            @id @default(cuid())
  userId       String            @unique
  slug         String            @unique
  displayName  String
  avatarUrl    String?
  bio          String?           @db.Text
  tradingStyle String?
  markets      String[]          @default([])
  pricingType  SignalPricingType @default(FREE)
  priceCents   Int               @default(0)
  currency     String            @default("USD")
  verified     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  signals       Signal[]
  subscriptions SignalSubscription[]

  @@map("signal_provider_profiles")
}

model Signal {
  id             String          @id @default(cuid())
  providerId     String
  instrument     String // e.g. "EURUSD"
  direction      SignalDirection
  status         SignalStatus    @default(ACTIVE)
  entryZoneLow   Float?
  entryZoneHigh  Float?
  stopLoss       Float?
  takeProfit     Float[]         @default([])
  timeframe      SignalTimeframe
  reasonMarkdown String?         @db.Text
  resultPips     Float? // filled when status -> CLOSED; null while ACTIVE
  publishedAt    DateTime        @default(now())
  closedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  provider SignalProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, publishedAt])
  @@index([status, publishedAt])
  @@index([instrument, publishedAt])
  @@map("signals")
}

model SignalSubscription {
  id                String             @id @default(cuid())
  userId            String
  providerId        String
  status            SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider SignalProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@map("signal_subscriptions")
}

// ---------- User alerts ----------

enum AlertType {
  ECONOMIC_EVENT
  CURRENCY
  SIGNAL_PROVIDER
  PRODUCT
  NEWS_TOPIC
}

enum AlertChannel {
  IN_APP
  EMAIL
  PUSH // not implemented yet — see src/features/alerts/dispatch-service.ts
}

// Polymorphic by convention, uniformly via `targetId` (required — every
// alert type has a concrete target: a currency code for CURRENCY, an
// EconomicEvent id for ECONOMIC_EVENT, a SignalProviderProfile id for
// SIGNAL_PROVIDER, a Product id for PRODUCT, a NewsCategory id for
// NEWS_TOPIC). Deliberately no FK to any of those tables: a target row
// being deleted shouldn't cascade-delete the subscription — "notify me
// about EURUSD" shouldn't vanish just because one EconomicEvent row
// mentioning EURUSD was removed. Also: a nullable field can't cleanly
// participate in a compound unique constraint for findUnique/upsert
// lookups (Postgres NULLs aren't equal to each other), which is the other
// reason this is required rather than optional.
model Alert {
  id        String         @id @default(cuid())
  userId    String
  type      AlertType
  targetId  String
  channels  AlertChannel[] @default([IN_APP])
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, targetId])
  @@index([type, targetId])
  @@map("alerts")
}

// ---------- Data sync architecture ----------

enum DataSourceKind {
  CALENDAR
  NEWS
  MARKET_DATA
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

// Admin-manageable registry of where calendar/news/market data comes from.
// `providerKey` matches a provider adapter's key (see
// src/services/calendar/providers, src/services/news/providers) so an admin
// can enable/disable or reconfigure a source without a deploy.
model DataSource {
  id             String         @id @default(cuid())
  name           String
  kind           DataSourceKind
  providerKey    String
  enabled        Boolean        @default(true)
  config         Json?
  lastSyncAt     DateTime?
  lastSyncStatus SyncStatus?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([kind, providerKey])
  @@map("data_sources")
}

// One row per background job run — gives admins visibility into sync
// failures instead of only finding out when the calendar looks stale.
model SyncLog {
  id             String     @id @default(cuid())
  jobName        String // "calendarSync" | "newsSync" | "marketDataSync"
  status         SyncStatus
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  itemsProcessed Int?
  itemsFailed    Int        @default(0)
  // Calendar-sync breakdown of itemsProcessed — null for jobs that don't
  // report this level of detail (e.g. newsSync/marketDataSync still only
  // set itemsProcessed/itemsFailed). Powers the admin calendar dashboard's
  // "inserted / updated / cancelled" counts (spec section 15).
  itemsInserted  Int?
  itemsUpdated   Int?
  itemsCancelled Int?
  error          String?    @db.Text

  @@index([jobName, startedAt])
  @@map("sync_logs")
}

// ---------- Marketplace configuration ----------

// Singleton row (id is always "singleton") holding admin-configurable
// marketplace-wide settings. Read via src/features/admin/settings-service.ts,
// which upserts the row on first read so callers never have to null-check.
model MarketplaceSettings {
  id                String   @id @default("singleton")
  commissionPercent Float    @default(20)
  // Weights for the discovery ranking score (see
  // src/lib/ranking/ranking-service.ts) — sales, downloads, reviews,
  // rating, recency, favorites. Admin-editable at /admin/settings.
  rankingWeights    Json     @default("{\"sales\":3,\"downloads\":1,\"reviews\":1,\"rating\":2,\"recency\":1,\"favorites\":1}")
  updatedAt         DateTime @updatedAt

  @@map("marketplace_settings")
}
