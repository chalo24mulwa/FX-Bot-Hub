// FX Bot Market — Phase 1 schema
// Extend this file in later phases; do not replace models wholesale.
// Run `npx prisma migrate dev --name <change>` after editing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // bcrypt hash, only set for credentials sign-in
  role          UserRole  @default(BUYER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  vendorProfile VendorProfile?
  products      Product[]       @relation("ProductVendor")
  reviews       Review[]
  orders        Order[]
  licenses      License[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

// ---------- Vendor / marketplace ----------

model VendorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  bio         String?  @db.Text
  websiteUrl  String?
  payoutEmail String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vendor_profiles")
}

model Category {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  parentId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

enum ProductType {
  EXPERT_ADVISOR
  INDICATOR
  SCRIPT
  UTILITY
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum PlatformTarget {
  MT4
  MT5
  BOTH
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  vendorId      String
  categoryId    String?
  name          String
  type          ProductType
  platform      PlatformTarget @default(MT5)
  shortSummary  String
  description   String         @db.Text
  priceCents    Int // 0 = free
  currency      String         @default("USD")
  status        ProductStatus  @default(DRAFT)
  searchVector  Unsupported("tsvector")?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  publishedAt   DateTime?

  vendor   User      @relation("ProductVendor", fields: [vendorId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  versions   ProductVersion[]
  images     ProductImage[]
  reviews    Review[]
  orderItems OrderItem[]
  licenses   License[]

  @@index([status, type])
  @@map("products")
}

model ProductVersion {
  id           String   @id @default(cuid())
  productId    String
  version      String
  changelog    String?  @db.Text
  fileStorageKey String // key in object storage, resolved via StorageProvider
  fileSizeBytes  Int
  checksumSha256 String
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, version])
  @@map("product_versions")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  storageKey String
  altText   String?
  position  Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int // 1-5
  title     String?
  body      String?  @db.Text
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("reviews")
}

// ---------- Orders / payments / licensing ----------

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  status        OrderStatus @default(PENDING)
  totalCents    Int
  currency      String      @default("USD")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payments Payment[]

  @@map("orders")
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productId  String
  unitPriceCents Int
  quantity   Int    @default(1)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

enum PaymentProviderName {
  STRIPE
  MPESA
  MANUAL
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                String              @id @default(cuid())
  orderId           String
  provider          PaymentProviderName
  status            PaymentStatus       @default(INITIATED)
  amountCents       Int
  currency          String              @default("USD")
  providerReference String? // e.g. Stripe payment_intent id, M-Pesa checkout request id
  rawPayload        Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider, providerReference])
  @@map("payments")
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model License {
  id        String        @id @default(cuid())
  userId    String
  productId String
  status    LicenseStatus @default(ACTIVE)
  key       String        @unique @default(cuid())
  activations Int         @default(0)
  maxActivations Int      @default(1)
  issuedAt  DateTime      @default(now())
  expiresAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("licenses")
}

// ---------- Economic calendar ----------

enum EventImpact {
  LOW
  MEDIUM
  HIGH
}

model EconomicEvent {
  id         String      @id @default(cuid())
  externalId String?     @unique // id from upstream data provider, for de-duplication on sync
  country    String
  currency   String
  title      String
  impact     EventImpact
  eventTime  DateTime
  actual     String?
  forecast   String?
  previous   String?
  source     String // e.g. "manual", "provider:xyz"
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([eventTime])
  @@index([currency, eventTime])
  @@map("economic_events")
}
