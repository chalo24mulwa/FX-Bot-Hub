// FX Bot Market — schema
// Extend this file; do not replace models wholesale.
// Run `npx prisma migrate dev --name <change>` after editing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // bcrypt hash, only set for credentials sign-in
  role          UserRole  @default(USER)
  bannedAt      DateTime? // set by an admin/moderator; blocks credentials sign-in
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  profile       Profile?
  sellerProfile SellerProfile?

  products      Product[]      @relation("ProductSeller")
  reviews       Review[]
  ratings       ProductRating[]
  favorites     Favorite[]
  downloads     Download[]
  orders        Order[]
  licenses      License[]
  subscriptions Subscription[]
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("AuditActor")

  @@map("users")
}

// Public-facing profile, distinct from SellerProfile's business/payout data.
// Every user gets one; only sellers additionally get a SellerProfile.
model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String?
  bio           String?  @db.Text
  avatarUrl     String?
  location      String?
  websiteUrl    String?
  twitterHandle String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Role hierarchy (low -> high privilege), enforced centrally in
// src/lib/authorization — never hard-code role checks in page components.
// USER < SELLER == AUTHOR < MODERATOR < ADMIN < SUPER_ADMIN
enum UserRole {
  USER
  SELLER
  AUTHOR
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

// ---------- Seller / marketplace catalog ----------

model SellerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  bio         String?  @db.Text
  websiteUrl  String?
  payoutEmail String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model ProductCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  parentId String?

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@map("product_categories")
}

enum ProductType {
  EA
  INDICATOR
  SIGNAL
  TOOL
  OTHER
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum Platform {
  MT4
  MT5
  MULTI_PLATFORM
}

// Governs how priceCents is interpreted: FREE => priceCents must be 0,
// ONE_TIME => a single purchase, SUBSCRIPTION => price per billing period
// (see Subscription for the recurring state).
enum PricingType {
  FREE
  ONE_TIME
  SUBSCRIPTION
}

model Product {
  id            String          @id @default(cuid())
  slug          String          @unique
  sellerId      String
  categoryId    String?
  name          String
  type          ProductType
  platform      Platform        @default(MT5)
  shortSummary  String
  description   String          @db.Text
  pricingType   PricingType     @default(ONE_TIME)
  priceCents    Int // 0 when pricingType = FREE
  currency      String          @default("USD")
  status        ProductStatus   @default(DRAFT)
  featured      Boolean         @default(false)
  tags          String[]        @default([])
  searchVector  Unsupported("tsvector")?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  publishedAt   DateTime?

  seller   User             @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  versions      ProductVersion[]
  images        ProductImage[]
  screenshots   ProductScreenshot[]
  documentation ProductDocumentation[]
  reviews       Review[]
  ratings       ProductRating[]
  rating        ProductRatingSummary?
  favorites     Favorite[]
  downloads     Download[]
  orderItems    OrderItem[]
  licenses      License[]
  subscriptions Subscription[]

  @@index([status, type])
  @@index([status, featured])
  @@index([status, pricingType])
  @@map("products")
}

model ProductVersion {
  id        String   @id @default(cuid())
  productId String
  version   String
  changelog String?  @db.Text
  createdAt DateTime @default(now())

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  files   ProductFile[]

  @@unique([productId, version])
  @@map("product_versions")
}

// A version can ship more than one file (e.g. separate MT4 and MT5 builds).
model ProductFile {
  id               String   @id @default(cuid())
  productVersionId String
  platform         Platform
  fileName         String
  storageKey       String // key in object storage, resolved via StorageProvider
  fileSizeBytes    Int
  checksumSha256   String
  createdAt        DateTime @default(now())

  productVersion ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  downloads      Download[]

  @@map("product_files")
}

// Cover / gallery images shown on the product card and listing.
model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  storageKey String
  altText    String?
  position   Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// In-app screenshots (e.g. backtest results, chart setups) — distinct from
// the cover/gallery images used in listings.
model ProductScreenshot {
  id         String  @id @default(cuid())
  productId  String
  storageKey String
  caption    String?
  position   Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_screenshots")
}

model ProductDocumentation {
  id              String   @id @default(cuid())
  productId       String
  title           String
  contentMarkdown String?  @db.Text
  storageKey      String? // optional PDF/attachment alternative to inline markdown
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_documentation")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int // 1-5
  title     String?
  body      String?  @db.Text
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("reviews")
}

// Lightweight star-only rating, for users who rate without writing a full
// review. Kept separate from Review (which also carries a body) so a user
// can do either without the two flows colliding on the same unique key.
model ProductRating {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@map("product_ratings")
}

// Materialized aggregate (average + star breakdown) over Review + ProductRating,
// recomputed by the review/rating service on write. Read this for display
// instead of aggregating on every request.
model ProductRatingSummary {
  productId String   @id
  average   Float    @default(0)
  count     Int      @default(0)
  star1     Int      @default(0)
  star2     Int      @default(0)
  star3     Int      @default(0)
  star4     Int      @default(0)
  star5     Int      @default(0)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_rating_summaries")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model Download {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  productFileId String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productFile ProductFile? @relation(fields: [productFileId], references: [id], onDelete: SetNull)

  @@index([userId, productId])
  @@index([productId])
  @@map("downloads")
}

// ---------- Orders / payments / licensing / subscriptions ----------

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  status     OrderStatus @default(PENDING)
  totalCents Int
  currency   String      @default("USD")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payments Payment[]

  @@map("orders")
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  unitPriceCents Int
  quantity       Int    @default(1)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

enum PaymentProviderName {
  STRIPE
  MPESA
  MANUAL
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                String              @id @default(cuid())
  orderId           String
  provider          PaymentProviderName
  status            PaymentStatus       @default(INITIATED)
  amountCents       Int
  currency          String              @default("USD")
  providerReference String? // e.g. Stripe payment_intent id, M-Pesa checkout request id
  rawPayload        Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([provider, providerReference])
  @@map("payments")
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model License {
  id             String        @id @default(cuid())
  userId         String
  productId      String
  status         LicenseStatus @default(ACTIVE)
  key            String        @unique @default(cuid())
  activations    Int           @default(0)
  maxActivations Int           @default(1)
  issuedAt       DateTime      @default(now())
  expiresAt      DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("licenses")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

model Subscription {
  id                 String              @id @default(cuid())
  userId             String
  productId          String
  status             SubscriptionStatus  @default(ACTIVE)
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean             @default(false)
  provider           PaymentProviderName?
  providerReference  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("subscriptions")
}

// ---------- Notifications / audit ----------

enum NotificationType {
  GENERAL
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  PRODUCT_SUSPENDED
  ORDER_PAID
  REVIEW_RECEIVED
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// Append-only moderation/action trail. actorId is nullable for
// system-initiated entries (e.g. a scheduled job).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "product.approve", "user.role_change"
  entityType String // e.g. "Product", "User"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------- Economic calendar ----------

enum EventImpact {
  LOW
  MEDIUM
  HIGH
}

model EconomicEvent {
  id         String      @id @default(cuid())
  externalId String?     @unique // id from upstream data provider, for de-duplication on sync
  country    String
  currency   String
  title      String
  impact     EventImpact
  eventTime  DateTime
  actual     String?
  forecast   String?
  previous   String?
  source     String // e.g. "manual", "provider:xyz"
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([eventTime])
  @@index([currency, eventTime])
  @@map("economic_events")
}
